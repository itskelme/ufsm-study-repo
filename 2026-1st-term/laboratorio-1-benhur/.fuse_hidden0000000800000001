// l1-t3-fulano.c
//
// Gerenciador de notas (post-its) - Trabalho 3 - l126a
//
// Cada nota tem um texto, uma etiqueta (3 letras), uma cor (rgb) e um
// retangulo (posicao e tamanho na tela). As notas ficam num vetor alocado
// dinamicamente, que cresce e encolhe conforme a necessidade. O vetor e
// lido de um arquivo no inicio e gravado de volta no fim (e na tecla 'g').
//
// O programa e modal: a cada momento esta em um dos modos abaixo, e cada
// modo tem sua propria funcao de laco, sua funcao de desenho e suas acoes.
//   - principal           : navegacao 2D com o cursor sobre os retangulos
//   - edicao de texto      : altera o texto da nota corrente
//   - edicao de etiqueta   : altera a etiqueta da nota corrente
//   - edicao de cor        : altera a cor da nota corrente
//   - busca de texto       : altera o texto de busca (filtra as notas)
//   - busca de etiqueta    : altera a etiqueta de busca (filtra as notas)
//
// Suporta retangulos + cor + etiquetas (versao completa).
//
// compilar:  gcc -Wall -o l1-t3 l1-t3-fulano.c tela.c
// executar:  ./l1-t3 [arquivo_de_notas]

#include "tela.h"
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <string.h>

// ----------------------------------------------------------------------
// constantes e tipos
// ----------------------------------------------------------------------

#define MAX_TEXTO     120   // limite de bytes do texto (o enunciado exige >= 100)
#define TAM_ETIQUETA    3   // toda etiqueta tem exatamente 3 caracteres
#define CAP_INICIAL     8   // capacidade inicial do vetor de notas
#define MIN_LADO        1   // menor largura/altura possivel de um retangulo

#define ARQ_PADRAO    "notas.txt"
#define ARQ_PROBLEMAS "notas-problemas.txt"

// uma cor, com os componentes rgb entre 0 e 255
typedef struct {
  int r, g, b;
} cor;

// um ponto na tela (coluna x, linha y)
typedef struct {
  int x, y;
} ponto;

// um tamanho (largura e altura)
typedef struct {
  int larg, alt;
} tamanho;

// um retangulo: canto superior esquerdo + tamanho
typedef struct {
  ponto pos;
  tamanho tam;
} retangulo;

// uma nota
typedef struct {
  char etiqueta[TAM_ETIQUETA + 1];  // 3 letras + '\0'
  cor c;
  retangulo ret;
  char texto[MAX_TEXTO + 1];
} nota;

// os modos de operacao do programa
typedef enum {
  modo_principal,
  modo_edita_texto,
  modo_edita_etiqueta,
  modo_edita_cor,
  modo_busca_texto,
  modo_busca_etiqueta,
  modo_fim,
} modo_t;

// estado completo do programa, passado por referencia para as funcoes
typedef struct {
  modo_t modo;

  nota *notas;        // vetor alocado dinamicamente
  int n;              // quantas notas estao em uso
  int cap;            // capacidade atual do vetor

  int tela_larg;      // tamanho da tela, em caracteres
  int tela_alt;
  ponto cursor;       // posicao do cursor na tela

  bool tem_removida;  // existe "ultima nota removida"?
  nota removida;

  char busca_texto[MAX_TEXTO + 1];
  char busca_etiqueta[TAM_ETIQUETA + 1];

  // dados usados pelos modos de edicao
  char edita_texto[MAX_TEXTO + 1];
  int edita_cursor;                    // posicao do cursor na edicao de texto
  char edita_etiqueta[TAM_ETIQUETA + 1];
  cor edita_cor;
  int comp_sel;                        // componente de cor selecionado (0=r,1=g,2=b)
  bool ultimo_digito;                  // a tecla anterior foi um digito? (edicao de cor)
  int busca_cursor;                    // posicao do cursor na edicao do texto de busca

  char nome_arquivo[256];
} estado_t;

// ----------------------------------------------------------------------
// utilidades pequenas
// ----------------------------------------------------------------------

// limita v ao intervalo [lo, hi]
static int limita(int v, int lo, int hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

// caractere valido para o texto de uma nota?
// imprimivel ASCII (32 a 126), menos aspas duplas
static bool valido_texto(int c)
{
  return c >= 32 && c <= 126 && c != '"';
}

// caractere valido para uma etiqueta? letra maiuscula ou digito
static bool valido_etiqueta(int c)
{
  return (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
}

// cor de texto que contrasta com o fundo c:
// fundo escuro (media < 120) pede texto claro, e vice-versa
static cor cor_contraste(cor c)
{
  int media = (c.r + c.g + c.b) / 3;
  if (media < 120) return (cor){ 240, 240, 240 };
  return (cor){ 16, 16, 16 };
}

// o ponto p esta dentro do retangulo r?
static bool dentro(retangulo r, ponto p)
{
  return p.x >= r.pos.x && p.x < r.pos.x + r.tam.larg
      && p.y >= r.pos.y && p.y < r.pos.y + r.tam.alt;
}

// ----------------------------------------------------------------------
// alocacao dinamica do vetor de notas
// ----------------------------------------------------------------------

// garante que cabe pelo menos mais uma nota no vetor.
// se precisar, dobra a capacidade. retorna false se a realocacao falhar.
static bool garante_espaco(estado_t *e)
{
  if (e->n < e->cap) return true;
  int nova = (e->cap < CAP_INICIAL) ? CAP_INICIAL : e->cap * 2;
  nota *novo = realloc(e->notas, nova * sizeof(nota));
  if (novo == NULL) return false;
  e->notas = novo;
  e->cap = nova;
  return true;
}

// encolhe o vetor se a ocupacao ficou muito baixa (menos de 30% da
// capacidade), para nao desperdicar memoria. nunca abaixo de CAP_INICIAL.
static void talvez_encolhe(estado_t *e)
{
  if (e->cap <= CAP_INICIAL) return;
  if (e->n >= e->cap * 3 / 10) return;
  int nova = e->cap / 2;
  if (nova < CAP_INICIAL) nova = CAP_INICIAL;
  nota *novo = realloc(e->notas, nova * sizeof(nota));
  if (novo != NULL) {
    e->notas = novo;
    e->cap = nova;
  }
}

// insere a nota nt na posicao idx, empurrando as demais para frente.
// mantem a ordem das outras notas. retorna false se faltar memoria.
static bool insere_nota(estado_t *e, nota nt, int idx)
{
  if (!garante_espaco(e)) return false;
  idx = limita(idx, 0, e->n);
  for (int i = e->n; i > idx; i--) {
    e->notas[i] = e->notas[i - 1];
  }
  e->notas[idx] = nt;
  e->n++;
  return true;
}

// remove a nota na posicao idx, puxando as demais para tras.
static void remove_nota(estado_t *e, int idx)
{
  if (idx < 0 || idx >= e->n) return;
  for (int i = idx; i < e->n - 1; i++) {
    e->notas[i] = e->notas[i + 1];
  }
  e->n--;
  talvez_encolhe(e);
}

// move a nota de origem para destino, mantendo a ordem relativa das outras
static void move_nota(estado_t *e, int origem, int destino)
{
  if (origem < 0 || origem >= e->n) return;
  nota tmp = e->notas[origem];
  remove_nota(e, origem);
  insere_nota(e, tmp, destino);
}

// ----------------------------------------------------------------------
// filtragem (busca) e escolha da nota corrente
// ----------------------------------------------------------------------

// a nota de indice i deve ser ignorada por causa do texto/etiqueta de busca?
static bool filtrada(estado_t *e, int i)
{
  nota *nt = &e->notas[i];
  if (e->busca_texto[0] != '\0' && strstr(nt->texto, e->busca_texto) == NULL) {
    return true;
  }
  if (e->busca_etiqueta[0] != '\0'
      && strncmp(nt->etiqueta, e->busca_etiqueta,
                 strlen(e->busca_etiqueta)) != 0) {
    return true;
  }
  return false;
}

// indice da nota corrente: a nota nao filtrada mais proxima do fim do vetor
// que contem o cursor. retorna -1 se nao houver nota sob o cursor.
static int nota_corrente(estado_t *e)
{
  for (int i = e->n - 1; i >= 0; i--) {
    if (filtrada(e, i)) continue;
    if (dentro(e->notas[i].ret, e->cursor)) return i;
  }
  return -1;
}

// ----------------------------------------------------------------------
// leitura e escrita do arquivo
// ----------------------------------------------------------------------

// le uma linha do arquivo para uma string alocada dinamicamente (sem o
// '\n'). retorna NULL no fim do arquivo. quem chama deve liberar (free).
static char *le_linha(FILE *f)
{
  int cap = 64;
  int n = 0;
  char *s = malloc(cap);
  if (s == NULL) return NULL;
  int c;
  while ((c = fgetc(f)) != EOF && c != '\n') {
    if (n + 1 >= cap) {
      cap *= 2;
      char *t = realloc(s, cap);
      if (t == NULL) { free(s); return NULL; }
      s = t;
    }
    s[n++] = c;
  }
  if (c == EOF && n == 0) { free(s); return NULL; }
  s[n] = '\0';
  return s;
}

// le um inteiro a partir de *p (pulando espacos antes). avanca *p.
// retorna false se nao houver um numero ali.
static bool le_inteiro(const char **p, int *valor)
{
  const char *s = *p;
  while (*s == ' ' || *s == '\t') s++;
  bool neg = false;
  if (*s == '-') { neg = true; s++; }
  if (*s < '0' || *s > '9') return false;
  int n = 0;
  while (*s >= '0' && *s <= '9') {
    n = n * 10 + (*s - '0');
    s++;
  }
  *valor = neg ? -n : n;
  *p = s;
  return true;
}

// interpreta uma linha do arquivo, preenchendo *nt.
// retorna false se a linha estiver mal formatada.
// *trunc fica true se o texto teve de ser cortado por ser longo demais.
static bool interpreta_linha(const char *linha, nota *nt, bool *trunc)
{
  *trunc = false;
  const char *p = linha;

  // pula espacos iniciais
  while (*p == ' ' || *p == '\t') p++;

  // etiqueta: exatamente 3 caracteres validos
  for (int i = 0; i < TAM_ETIQUETA; i++) {
    if (!valido_etiqueta(p[i])) return false;
    nt->etiqueta[i] = p[i];
  }
  nt->etiqueta[TAM_ETIQUETA] = '\0';
  p += TAM_ETIQUETA;

  // cor (3 numeros) e retangulo (4 numeros)
  int r, g, b, x, y, larg, alt;
  if (!le_inteiro(&p, &r))    return false;
  if (!le_inteiro(&p, &g))    return false;
  if (!le_inteiro(&p, &b))    return false;
  if (!le_inteiro(&p, &x))    return false;
  if (!le_inteiro(&p, &y))    return false;
  if (!le_inteiro(&p, &larg)) return false;
  if (!le_inteiro(&p, &alt))  return false;

  // texto: comeca depois das aspas de abertura
  while (*p == ' ' || *p == '\t') p++;
  if (*p != '"') return false;
  p++;
  int k = 0;
  while (*p != '\0' && *p != '"') {
    unsigned char ch = (unsigned char)*p;
    p++;
    // sem suporte a UTF8: ignora codigos acima de 126; ignora controles
    if (ch < 32 || ch > 126) continue;
    if (k < MAX_TEXTO) {
      nt->texto[k++] = ch;
    } else {
      *trunc = true;  // sobrou texto, vai para o arquivo de problemas
    }
  }
  if (*p != '"') return false;  // faltou fechar as aspas
  nt->texto[k] = '\0';

  // preenche cor e retangulo (com os valores ajustados aos limites validos)
  nt->c.r = limita(r, 0, 255);
  nt->c.g = limita(g, 0, 255);
  nt->c.b = limita(b, 0, 255);
  nt->ret.pos.x = x;
  nt->ret.pos.y = y;
  nt->ret.tam.larg = (larg < MIN_LADO) ? MIN_LADO : larg;
  nt->ret.tam.alt  = (alt  < MIN_LADO) ? MIN_LADO : alt;
  return true;
}

// acrescenta uma linha problematica ao fim do arquivo de problemas
static void grava_problema(const char *linha)
{
  FILE *f = fopen(ARQ_PROBLEMAS, "a");
  if (f == NULL) return;
  fprintf(f, "%s\n", linha);
  fclose(f);
}

// le todas as notas do arquivo para o estado
static void carrega_arquivo(estado_t *e)
{
  FILE *f = fopen(e->nome_arquivo, "r");
  if (f == NULL) return;  // arquivo ainda nao existe: comeca vazio
  char *linha;
  while ((linha = le_linha(f)) != NULL) {
    nota nt;
    bool trunc;
    if (interpreta_linha(linha, &nt, &trunc)) {
      if (insere_nota(e, nt, e->n)) {
        if (trunc) grava_problema(linha);
      }
    } else {
      grava_problema(linha);  // linha mal formatada: guarda e ignora
    }
    free(linha);
  }
  fclose(f);
}

// grava uma nota no arquivo, no formato esperado
static void grava_nota(FILE *f, nota *nt)
{
  fprintf(f, "%s %d %d %d %d %d %d %d \"%s\"\n",
          nt->etiqueta, nt->c.r, nt->c.g, nt->c.b,
          nt->ret.pos.x, nt->ret.pos.y, nt->ret.tam.larg, nt->ret.tam.alt,
          nt->texto);
}

// grava todas as notas no arquivo
static void grava_arquivo(estado_t *e)
{
  FILE *f = fopen(e->nome_arquivo, "w");
  if (f == NULL) return;
  for (int i = 0; i < e->n; i++) {
    grava_nota(f, &e->notas[i]);
  }
  fclose(f);
}

// ----------------------------------------------------------------------
// desenho do modo principal
// ----------------------------------------------------------------------

// imprime um caractere na posicao (lin, col), se estiver dentro da tela
static void poe_char(estado_t *e, int lin, int col, char ch)
{
  if (lin < 1 || lin > e->tela_alt) return;
  if (col < 1 || col > e->tela_larg) return;
  t_lincol(lin, col);
  putchar(ch);
}

// desenha uma nota: preenche o retangulo com a cor, escreve o texto fluindo
// pelas linhas e poe a etiqueta no canto superior esquerdo
static void desenha_nota(estado_t *e, int idx)
{
  nota *nt = &e->notas[idx];
  cor fundo = nt->c;
  cor letra = cor_contraste(fundo);
  retangulo r = nt->ret;
  int tam = strlen(nt->texto);
  int p = 0;

  t_corfundo(fundo.r, fundo.g, fundo.b);
  t_cortexto(letra.r, letra.g, letra.b);

  // o texto preenche todo o retangulo, uma linha apos a outra
  for (int dl = 0; dl < r.tam.alt; dl++) {
    for (int dc = 0; dc < r.tam.larg; dc++) {
      char ch = (p < tam) ? nt->texto[p] : ' ';
      if (p < tam) p++;
      poe_char(e, r.pos.y + dl, r.pos.x + dc, ch);
    }
  }

  // etiqueta no canto superior esquerdo (cores trocadas, para destacar)
  t_corfundo(letra.r, letra.g, letra.b);
  t_cortexto(fundo.r, fundo.g, fundo.b);
  for (int i = 0; i < TAM_ETIQUETA; i++) {
    poe_char(e, r.pos.y, r.pos.x + i, nt->etiqueta[i]);
  }
}

// desenha uma moldura ao redor da nota corrente, para destaca-la
static void desenha_moldura(estado_t *e, int idx)
{
  retangulo r = e->notas[idx].ret;
  cor m = cor_contraste(e->notas[idx].c);
  t_corfundo(m.r, m.g, m.b);
  t_cortexto(e->notas[idx].c.r, e->notas[idx].c.g, e->notas[idx].c.b);
  int l = r.pos.y, c = r.pos.x, dl = r.tam.alt, dc = r.tam.larg;
  for (int i = 0; i < dc; i++) {
    poe_char(e, l, c + i, '=');
    poe_char(e, l + dl - 1, c + i, '=');
  }
  for (int i = 0; i < dl; i++) {
    poe_char(e, l + i, c, '|');
    poe_char(e, l + i, c + dc - 1, '|');
  }
}

// conta quantas notas estao visiveis (nao filtradas)
static int conta_visiveis(estado_t *e)
{
  int q = 0;
  for (int i = 0; i < e->n; i++) {
    if (!filtrada(e, i)) q++;
  }
  return q;
}

// desenha a barra de status na ultima linha da tela
static void desenha_status(estado_t *e, const char *texto)
{
  t_cornormal();
  t_lincol(e->tela_alt, 1);
  for (int c = 1; c <= e->tela_larg; c++) putchar(' ');
  t_lincol(e->tela_alt, 1);
  printf("%s", texto);
}

// desenho do modo principal
static void desenha_principal(estado_t *e)
{
  t_limpa();

  // as notas sao desenhadas na ordem do vetor: as do fim aparecem por cima
  for (int i = 0; i < e->n; i++) {
    if (!filtrada(e, i)) desenha_nota(e, i);
  }

  // destaca a nota corrente
  int corr = nota_corrente(e);
  if (corr >= 0) desenha_moldura(e, corr);

  // status: quantidade de notas e filtros ativos
  char info[256];
  snprintf(info, sizeof info,
           "notas:%d/%d  busca:\"%s\"  etiq:\"%s\"  "
           "[hjkl]move [n]ova [e]dita [c]or [t]ag [b]usca [g]rava [ESC]sai",
           conta_visiveis(e), e->n, e->busca_texto, e->busca_etiqueta);
  desenha_status(e, info);

  // o cursor fica por cima de tudo
  t_cursor(c_bloco, c_pisca);
  t_lincol(e->cursor.y, e->cursor.x);
  fflush(stdout);
}

// ----------------------------------------------------------------------
// acoes do modo principal
// ----------------------------------------------------------------------

// move o cursor um passo na direcao dada, sem sair da tela
static void move_cursor(estado_t *e, int dx, int dy)
{
  e->cursor.x = limita(e->cursor.x + dx, 1, e->tela_larg);
  e->cursor.y = limita(e->cursor.y + dy, 1, e->tela_alt);
}

// ajusta o retangulo r para conter o cursor, sem sair da tela
static void posiciona_no_cursor(estado_t *e, retangulo *r)
{
  r->pos.x = e->cursor.x;
  r->pos.y = e->cursor.y;
  if (r->pos.x + r->tam.larg - 1 > e->tela_larg) {
    r->pos.x = e->tela_larg - r->tam.larg + 1;
  }
  if (r->pos.y + r->tam.alt - 1 > e->tela_alt) {
    r->pos.y = e->tela_alt - r->tam.alt + 1;
  }
  r->pos.x = limita(r->pos.x, 1, e->tela_larg);
  r->pos.y = limita(r->pos.y, 1, e->tela_alt);
}

// cria uma nota nova, com conteudo padrao, no fim do vetor
static void acao_nova_nota(estado_t *e)
{
  nota nt;
  strcpy(nt.etiqueta, "AAA");
  nt.c = (cor){ 200, 200, 120 };
  nt.ret.tam.larg = 10;
  nt.ret.tam.alt = 4;
  nt.texto[0] = '\0';
  posiciona_no_cursor(e, &nt.ret);
  insere_nota(e, nt, e->n);  // se faltar memoria, simplesmente nao inclui
}

// remove a nota corrente, guardando-a como "ultima nota removida"
static void acao_remove(estado_t *e)
{
  int corr = nota_corrente(e);
  if (corr < 0) return;
  e->removida = e->notas[corr];
  e->tem_removida = true;
  remove_nota(e, corr);
}

// reinsere a ultima nota removida, no fim do vetor, sobre o cursor
static void acao_reinsere(estado_t *e)
{
  if (!e->tem_removida) return;
  nota nt = e->removida;
  posiciona_no_cursor(e, &nt.ret);
  if (insere_nota(e, nt, e->n)) {
    e->tem_removida = false;
  }
}

// posiciona o cursor sobre a nota mais proxima do fim do vetor
static void acao_pula_para_nota(estado_t *e)
{
  for (int i = e->n - 1; i >= 0; i--) {
    if (filtrada(e, i)) continue;
    retangulo r = e->notas[i].ret;
    e->cursor.x = limita(r.pos.x + r.tam.larg / 2, 1, e->tela_larg);
    e->cursor.y = limita(r.pos.y + r.tam.alt / 2, 1, e->tela_alt);
    return;
  }
}

// move o retangulo da nota corrente um passo, junto com o cursor
static void acao_move_nota(estado_t *e, int dx, int dy)
{
  int corr = nota_corrente(e);
  if (corr < 0) { move_cursor(e, dx, dy); return; }
  retangulo *r = &e->notas[corr].ret;
  // so move se o retangulo continuar inteiro dentro da tela
  if (r->pos.x + dx >= 1 && r->pos.x + r->tam.larg - 1 + dx <= e->tela_larg
   && r->pos.y + dy >= 1 && r->pos.y + r->tam.alt - 1 + dy <= e->tela_alt) {
    r->pos.x += dx;
    r->pos.y += dy;
  }
  move_cursor(e, dx, dy);
}

// aumenta o retangulo da nota corrente na direcao indicada
static void acao_aumenta(estado_t *e, char dir)
{
  int corr = nota_corrente(e);
  if (corr < 0) return;
  retangulo *r = &e->notas[corr].ret;
  if (dir == 'h' && r->pos.x > 1)                               { r->pos.x--; r->tam.larg++; }
  if (dir == 'l' && r->pos.x + r->tam.larg - 1 < e->tela_larg)  { r->tam.larg++; }
  if (dir == 'k' && r->pos.y > 1)                               { r->pos.y--; r->tam.alt++; }
  if (dir == 'j' && r->pos.y + r->tam.alt - 1 < e->tela_alt)    { r->tam.alt++; }
}

// diminui o retangulo da nota corrente na direcao indicada;
// se o retangulo deixar de cobrir o cursor, o cursor anda junto
static void acao_diminui(estado_t *e, char dir)
{
  int corr = nota_corrente(e);
  if (corr < 0) return;
  retangulo *r = &e->notas[corr].ret;
  if (dir == 'h' && r->tam.larg > MIN_LADO) {            // encolhe pela esquerda
    r->pos.x++; r->tam.larg--;
    if (e->cursor.x < r->pos.x) e->cursor.x = r->pos.x;
  }
  if (dir == 'l' && r->tam.larg > MIN_LADO) {            // encolhe pela direita
    r->tam.larg--;
    if (e->cursor.x > r->pos.x + r->tam.larg - 1) e->cursor.x = r->pos.x + r->tam.larg - 1;
  }
  if (dir == 'k' && r->tam.alt > MIN_LADO) {             // encolhe por cima
    r->pos.y++; r->tam.alt--;
    if (e->cursor.y < r->pos.y) e->cursor.y = r->pos.y;
  }
  if (dir == 'j' && r->tam.alt > MIN_LADO) {             // encolhe por baixo
    r->tam.alt--;
    if (e->cursor.y > r->pos.y + r->tam.alt - 1) e->cursor.y = r->pos.y + r->tam.alt - 1;
  }
}

// executa uma acao do modo principal conforme a tecla
static void acao_principal(estado_t *e, tecla_t tec)
{
  switch ((int) tec) {
    // sair do programa
    case T_ESC: case 'q':
      e->modo = modo_fim;
      break;

    // mover o cursor
    case 'h': case T_ESQUERDA: move_cursor(e, -1,  0); break;
    case 'l': case T_DIREITA:  move_cursor(e, +1,  0); break;
    case 'k': case T_CIMA:     move_cursor(e,  0, -1); break;
    case 'j': case T_BAIXO:    move_cursor(e,  0, +1); break;

    // mover o retangulo da nota corrente
    case 'H': case T_S_ESQUERDA: acao_move_nota(e, -1,  0); break;
    case 'L': case T_S_DIREITA:  acao_move_nota(e, +1,  0); break;
    case 'K': case T_S_CIMA:     acao_move_nota(e,  0, -1); break;
    case 'J': case T_S_BAIXO:    acao_move_nota(e,  0, +1); break;

    // aumentar o retangulo (ctrl + direcao)
    case T_CTRL_H: case T_C_ESQUERDA: acao_aumenta(e, 'h'); break;
    case T_CTRL_L: case T_C_DIREITA:  acao_aumenta(e, 'l'); break;
    case T_CTRL_K: case T_C_CIMA:     acao_aumenta(e, 'k'); break;
    case T_CTRL_J: case T_C_BAIXO:    acao_aumenta(e, 'j'); break;

    // diminuir o retangulo (ctrl+y/u/i/o ou alt + direcao);
    // as letras y/u/i/o indicam apenas a direcao (esq/baixo/cima/dir)
    case T_CTRL_Y: case T_A_ESQUERDA: acao_diminui(e, 'h'); break;
    case T_CTRL_O: case T_A_DIREITA:  acao_diminui(e, 'l'); break;
    case T_CTRL_I: case T_A_CIMA:     acao_diminui(e, 'k'); break;
    case T_CTRL_U: case T_A_BAIXO:    acao_diminui(e, 'j'); break;

    // ordem da nota corrente no vetor
    case 'i': {  // leva a nota corrente para o inicio do vetor
      int c = nota_corrente(e);
      if (c >= 0) move_nota(e, c, 0);
      break;
    }
    case 'f': {  // leva a nota corrente para o fim do vetor
      int c = nota_corrente(e);
      if (c >= 0) move_nota(e, c, e->n);
      break;
    }

    // remover / reinserir / criar
    case 'd': case T_DEL:  acao_remove(e); break;
    case 'I': case T_INS:  acao_reinsere(e); break;
    case 'n':              acao_nova_nota(e); break;

    // posiciona o cursor sobre a ultima nota
    case 'p': acao_pula_para_nota(e); break;

    // gravar o arquivo
    case 'g': grava_arquivo(e); break;

    // trocar de modo
    case 'e': e->modo = modo_edita_texto;    break;
    case 'c': e->modo = modo_edita_cor;      break;
    case 't': e->modo = modo_edita_etiqueta; break;
    case 'b': e->modo = modo_busca_texto;    break;
    case 'B': e->modo = modo_busca_etiqueta; break;

    default: ;  // qualquer outra tecla e ignorada
  }
}

// laco do modo principal
static void exec_principal(estado_t *e)
{
  desenha_principal(e);
  while (e->modo == modo_principal) {
    tecla_t tec = t_tecla();
    if (tec == T_NADA) continue;       // nada digitado: nao redesenha
    acao_principal(e, tec);
    if (e->modo == modo_principal) desenha_principal(e);
  }
}

