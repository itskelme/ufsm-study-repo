         "[ctrl+t] aplica a todas visiveis   [ESC] cancela");
  t_lincol(3, 1);
  printf("Etiqueta: %s", e->edita_etiqueta);
  t_cursor(c_sublinha, c_pisca);
  t_lincol(3, 11 + (int)strlen(e->edita_etiqueta));
  fflush(stdout);
}

static void acao_edita_etiqueta(estado_t *e, tecla_t tec)
{
  int tam = strlen(e->edita_etiqueta);
  switch (tec) {
    case T_ESC: case T_CTRL_C:
      e->modo = modo_principal;
      break;
    case T_BS: case T_CTRL_B:
      if (tam > 0) e->edita_etiqueta[tam - 1] = '\0';
      break;
    case T_ENTER:  // aplica na nota corrente
      if (tam == TAM_ETIQUETA) {
        int corr = nota_corrente(e);
        if (corr >= 0) strcpy(e->notas[corr].etiqueta, e->edita_etiqueta);
        e->modo = modo_principal;
      }
      break;
    case T_CTRL_T: case T_ALT_ENTER:  // aplica em todas as notas visiveis
      if (tam == TAM_ETIQUETA) {
        for (int i = 0; i < e->n; i++) {
          if (!filtrada(e, i)) strcpy(e->notas[i].etiqueta, e->edita_etiqueta);
        }
        e->modo = modo_principal;
      }
      break;
    default:
      if (valido_etiqueta(tec) && tam < TAM_ETIQUETA) {
        e->edita_etiqueta[tam] = tec;
        e->edita_etiqueta[tam + 1] = '\0';
      }
  }
}

static void exec_edita_etiqueta(estado_t *e)
{
  int corr = nota_corrente(e);
  if (corr >= 0) strcpy(e->edita_etiqueta, e->notas[corr].etiqueta);
  else e->edita_etiqueta[0] = '\0';

  desenha_edita_etiqueta(e);
  while (e->modo == modo_edita_etiqueta) {
    tecla_t tec = t_tecla();
    if (tec == T_NADA) continue;
    acao_edita_etiqueta(e, tec);
    if (e->modo == modo_edita_etiqueta) desenha_edita_etiqueta(e);
  }
}

// ----------------------------------------------------------------------
// modo de edicao de cor
// ----------------------------------------------------------------------

// devolve um ponteiro para o componente selecionado da cor sendo editada
static int *componente(estado_t *e)
{
  if (e->comp_sel == 0) return &e->edita_cor.r;
  if (e->comp_sel == 1) return &e->edita_cor.g;
  return &e->edita_cor.b;
}

static void desenha_edita_cor(estado_t *e)
{
  t_limpa();
  t_cornormal();
  t_lincol(1, 1);
  printf("EDICAO DE COR   [r/g/b] seleciona   [setas/jk] ajusta   "
         "[Enter] aplica   [ctrl+t] todas   [ESC] cancela");

  // amostra da cor
  cor c = e->edita_cor;
  t_corfundo(c.r, c.g, c.b);
  for (int l = 3; l <= 8; l++) {
    t_lincol(l, 4);
    printf("              ");
  }

  // valores dos componentes, com o selecionado destacado
  t_cornormal();
  const char *nome[3] = { "R", "G", "B" };
  int val[3] = { c.r, c.g, c.b };
  for (int i = 0; i < 3; i++) {
    t_lincol(3 + i, 22);
    if (i == e->comp_sel) printf("> %s: %3d <", nome[i], val[i]);
    else                  printf("  %s: %3d", nome[i], val[i]);
  }
  t_cursor(c_nada, c_naopisca);
  fflush(stdout);
}

static void acao_edita_cor(estado_t *e, tecla_t tec)
{
  int *comp = componente(e);
  bool digitou = false;

  switch (tec) {
    case 'e': case 'r': e->comp_sel = 0; break;
    case 'v': case 'g': e->comp_sel = 1; break;
    case 'a': case 'b': e->comp_sel = 2; break;
    case 'l': case T_DIREITA:   e->comp_sel = (e->comp_sel + 1) % 3; break;
    case 'h': case T_ESQUERDA:  e->comp_sel = (e->comp_sel + 2) % 3; break;

    case 'k': case T_CIMA:    if (*comp < 255) (*comp)++; break;
    case 'j': case T_BAIXO:   if (*comp > 0)   (*comp)--; break;
    case 'K': case T_S_CIMA:  *comp = limita(*comp + 16, 0, 255); break;
    case 'J': case T_S_BAIXO: *comp = limita(*comp - 16, 0, 255); break;

    case T_ENTER: {  // aplica na nota corrente
      int corr = nota_corrente(e);
      if (corr >= 0) e->notas[corr].c = e->edita_cor;
      e->modo = modo_principal;
      break;
    }
    case T_CTRL_T: case T_ALT_ENTER:  // aplica em todas as visiveis
      for (int i = 0; i < e->n; i++) {
        if (!filtrada(e, i)) e->notas[i].c = e->edita_cor;
      }
      e->modo = modo_principal;
      break;
    case T_ESC: case T_CTRL_B:
      e->modo = modo_principal;
      break;

    default:
      if (tec >= '0' && tec <= '9') {  // digita o valor do componente
        int d = tec - '0';
        if (e->ultimo_digito && *comp * 10 + d <= 255) *comp = *comp * 10 + d;
        else *comp = d;
        digitou = true;
      }
  }
  e->ultimo_digito = digitou;
}

static void exec_edita_cor(estado_t *e)
{
  int corr = nota_corrente(e);
  if (corr >= 0) e->edita_cor = e->notas[corr].c;
  e->comp_sel = 0;
  e->ultimo_digito = false;

  desenha_edita_cor(e);
  while (e->modo == modo_edita_cor) {
    tecla_t tec = t_tecla();
    if (tec == T_NADA) continue;
    acao_edita_cor(e, tec);
    if (e->modo == modo_edita_cor) desenha_edita_cor(e);
  }
}

