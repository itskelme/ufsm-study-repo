// remove o caractere na posicao pos de s
static void remove_char(char *s, int pos)
{
  int tam = strlen(s);
  if (pos < 0 || pos >= tam) return;
  for (int i = pos; i < tam; i++) s[i] = s[i + 1];
}

// insere o caractere ch na posicao pos de s, se couber (limite max bytes)
static bool insere_char(char *s, int pos, char ch, int max)
{
  int tam = strlen(s);
  if (tam >= max) return false;
  for (int i = tam; i > pos; i--) s[i] = s[i - 1];
  s[pos] = ch;
  s[tam + 1] = '\0';
  return true;
}

// desenha uma string a partir de uma linha, quebrando na largura da tela,
// e posiciona o cursor no caractere de indice cur
static void desenha_texto_editavel(estado_t *e, int linha0, const char *s, int cur)
{
  int larg = e->tela_larg;
  int tam = strlen(s);
  for (int i = 0; i <= tam; i++) {
    int lin = linha0 + i / larg;
    int col = 1 + i % larg;
    char ch = (i < tam) ? s[i] : ' ';
    if (lin <= e->tela_alt) {
      t_lincol(lin, col);
      putchar(ch);
    }
  }
  int lin = linha0 + cur / larg;
  int col = 1 + cur % larg;
  t_cursor(c_barra, c_pisca);
  t_lincol(lin, col);
}

static void desenha_edita_texto(estado_t *e)
{
  t_limpa();
  t_cornormal();
  t_lincol(1, 1);
  printf("EDICAO DE TEXTO   [Enter] confirma   [ESC] cancela");
  desenha_texto_editavel(e, 3, e->edita_texto, e->edita_cursor);
  fflush(stdout);
}

static void acao_edita_texto(estado_t *e, tecla_t tec)
{
  int tam = strlen(e->edita_texto);
  switch (tec) {
    case T_ENTER: {  // confirma: copia para a nota corrente
      int corr = nota_corrente(e);
      if (corr >= 0) strcpy(e->notas[corr].texto, e->edita_texto);
      e->modo = modo_principal;
      break;
    }
    case T_ESC: case T_CTRL_C:        // cancela
      e->modo = modo_principal;
      break;
    case T_BS: case T_CTRL_B:         // apaga o caractere antes do cursor
      if (e->edita_cursor > 0) {
        e->edita_cursor--;
        remove_char(e->edita_texto, e->edita_cursor);
      }
      break;
    case T_DEL: case T_CTRL_D:        // apaga o caractere sob o cursor
      if (e->edita_cursor < tam) remove_char(e->edita_texto, e->edita_cursor);
      break;
    case T_ESQUERDA: case T_CTRL_H:
      if (e->edita_cursor > 0) e->edita_cursor--;
      break;
    case T_DIREITA: case T_CTRL_L:
      if (e->edita_cursor < tam) e->edita_cursor++;
      break;
    case T_HOME: case T_CTRL_K:
      e->edita_cursor = 0;
      break;
    case T_END: case T_CTRL_J:
      e->edita_cursor = tam;
      break;
    default:
      if (valido_texto(tec)) {
        if (insere_char(e->edita_texto, e->edita_cursor, tec, MAX_TEXTO)) {
          e->edita_cursor++;
        }
      }
  }
}

static void exec_edita_texto(estado_t *e)
{
  // ao entrar no modo, copia o texto da nota corrente para edicao
  int corr = nota_corrente(e);
  if (corr < 0) { e->modo = modo_principal; return; }
  strcpy(e->edita_texto, e->notas[corr].texto);
  e->edita_cursor = strlen(e->edita_texto);

  desenha_edita_texto(e);
  while (e->modo == modo_edita_texto) {
    tecla_t tec = t_tecla();
    if (tec == T_NADA) continue;
    acao_edita_texto(e, tec);
    if (e->modo == modo_edita_texto) desenha_edita_texto(e);
  }
}

