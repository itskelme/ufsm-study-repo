// ----------------------------------------------------------------------
// inicializacao e laco principal
// ----------------------------------------------------------------------

// inicializa o estado e le as notas do arquivo
static void inicializa(estado_t *e, const char *nome)
{
  e->modo = modo_principal;
  e->notas = NULL;
  e->n = 0;
  e->cap = 0;
  e->tem_removida = false;
  e->busca_texto[0] = '\0';
  e->busca_etiqueta[0] = '\0';
  e->edita_cursor = 0;
  e->busca_cursor = 0;
  e->comp_sel = 0;
  e->ultimo_digito = false;
  strncpy(e->nome_arquivo, nome, sizeof(e->nome_arquivo) - 1);
  e->nome_arquivo[sizeof(e->nome_arquivo) - 1] = '\0';
  carrega_arquivo(e);
}

int main(int argc, char *argv[])
{
  estado_t e;
  inicializa(&e, (argc > 1) ? argv[1] : ARQ_PADRAO);

  t_inicia();

  // descobre o tamanho da tela (com valores de reserva, caso nao responda)
  t_tamanho(&e.tela_larg, &e.tela_alt);
  if (e.tela_larg <= 0) e.tela_larg = 80;
  if (e.tela_alt  <= 0) e.tela_alt  = 24;
  e.cursor.x = e.tela_larg / 2;
  e.cursor.y = e.tela_alt / 2;

  // laco principal: chama a funcao do modo atual ate pedir para terminar
  while (e.modo != modo_fim) {
    switch (e.modo) {
      case modo_principal:       exec_principal(&e);       break;
      case modo_edita_texto:     exec_edita_texto(&e);     break;
      case modo_edita_etiqueta:  exec_edita_etiqueta(&e);  break;
      case modo_edita_cor:       exec_edita_cor(&e);       break;
      case modo_busca_texto:     exec_busca_texto(&e);     break;
      case modo_busca_etiqueta:  exec_busca_etiqueta(&e);  break;
      default: ;
    }
  }

  grava_arquivo(&e);  // garante que as notas nao se percam ao sair
  t_fim();
  free(e.notas);
  return 0;
}
